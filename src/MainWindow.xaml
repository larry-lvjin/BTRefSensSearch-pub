<Window x:Class="BTSensitivitySearchV1._0.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:BTSensitivitySearchV1._0.ViewModels"
        mc:Ignorable="d"
        Title="BTSensitivitySearchV1.0"
        Height="780" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================== Row 0: Connection ==================== -->
        <GroupBox Grid.Row="0">
            <GroupBox.Header>
                <TextBlock Text="&#x26A1; CMW500 Connection" FontWeight="Bold"
                           Foreground="{StaticResource HeaderYellow}" FontSize="14"/>
            </GroupBox.Header>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="VISA Address:" Margin="0,0,8,0"/>
                <ComboBox Grid.Column="1" Margin="0,0,12,0"
                          ItemsSource="{Binding VisaAddresses}"
                          SelectedItem="{Binding SelectedVisaAddress}"/>

                <Button Grid.Column="2" Content="&#x1F50C; Connect" Margin="0,0,6,0"
                        Background="#2E7D32"
                        Command="{Binding ConnectCommand}"/>
                <Button Grid.Column="3" Content="Disconnect" Margin="0,0,12,0"
                        Background="#C62828"
                        Command="{Binding DisconnectCommand}"/>

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#F44336"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="#4CAF50"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource DimTextBrush}"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- ==================== Row 1: Test Configuration ==================== -->
        <GroupBox Grid.Row="1">
            <GroupBox.Header>
                <TextBlock Text="&#x2699; Test Configuration" FontWeight="Bold"
                           Foreground="{StaticResource HeaderGreen}" FontSize="14"/>
            </GroupBox.Header>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Test Mode:" Margin="0,0,8,0"/>
                <ComboBox Grid.Column="1" Margin="0,0,20,0"
                          ItemsSource="{Binding TestModeItems}"
                          SelectedValue="{Binding SelectedTestMode}"
                          SelectedValuePath="Mode"
                          DisplayMemberPath="DisplayName"/>

                <TextBlock Grid.Column="2" Text="Cable Loss (dB):" Margin="0,0,8,0"/>
                <TextBox Grid.Column="3" Text="{Binding CableLoss, StringFormat=F1}" Margin="0,0,20,0"/>

                <!-- Phase display -->
                <TextBlock Grid.Column="6" Text="{Binding CurrentPhase}"
                           Foreground="#FFC107" FontStyle="Italic" Margin="0,0,20,0"/>

                <!-- Buttons -->
                <Button Grid.Column="7" Content="&#x25B6; Start" Margin="0,0,6,0"
                        FontWeight="Bold" Background="#1565C0" MinWidth="90"
                        Command="{Binding StartCommand}"/>
                <Button Grid.Column="8" Margin="0,0,6,0" MinWidth="80">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Content" Value="&#x23F8; Pause"/>
                            <Setter Property="Background" Value="#F57F17"/>
                            <Setter Property="Command" Value="{Binding PauseCommand}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                    <Setter Property="Content" Value="&#x25B6; Resume"/>
                                    <Setter Property="Background" Value="#2E7D32"/>
                                    <Setter Property="Command" Value="{Binding ResumeCommand}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Grid.Column="9" Content="&#x23F9; Stop" Margin="0,0,6,0"
                        Background="#C62828" MinWidth="70"
                        Command="{Binding StopCommand}"/>
            </Grid>
        </GroupBox>

        <!-- ==================== Row 2: Result Table ==================== -->
        <GroupBox Grid.Row="2">
            <GroupBox.Header>
                <TextBlock Text="&#x1F4CB; Result" FontWeight="Bold"
                           Foreground="{StaticResource HeaderBlue}" FontSize="14"/>
            </GroupBox.Header>
            <ItemsControl ItemsSource="{Binding ResultRows}">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <StackPanel>
                            <!-- Table Header -->
                            <Grid Background="#263238" Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Type" FontWeight="Bold"
                                           Foreground="{StaticResource HeaderYellow}" Margin="8,6"/>
                                <TextBlock Grid.Column="1" Text="Threshold" FontWeight="Bold"
                                           Foreground="{StaticResource DimTextBrush}" Margin="8,6"/>
                                <TextBlock Grid.Column="2" Text="Start" FontWeight="Bold"
                                           Foreground="{StaticResource DimTextBrush}" Margin="8,6"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{Binding DataContext.Ch1Header, RelativeSource={RelativeSource AncestorType=Window}}"
                                           FontWeight="Bold" Foreground="{StaticResource HeaderYellow}"
                                           Margin="8,6" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="{Binding DataContext.Ch2Header, RelativeSource={RelativeSource AncestorType=Window}}"
                                           FontWeight="Bold" Foreground="{StaticResource HeaderYellow}"
                                           Margin="8,6" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="5" Text="{Binding DataContext.Ch3Header, RelativeSource={RelativeSource AncestorType=Window}}"
                                           FontWeight="Bold" Foreground="{StaticResource HeaderYellow}"
                                           Margin="8,6" HorizontalAlignment="Center"/>
                            </Grid>
                            <ItemsPresenter/>
                        </StackPanel>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Background="#1B2838" Margin="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding PacketTypeName}"
                                       FontWeight="Bold" Foreground="#4FC3F7" Margin="8,8"/>
                            <TextBlock Grid.Column="1" Text="{Binding Threshold}"
                                       Foreground="{StaticResource DimTextBrush}" Margin="8,8" FontSize="11"/>
                            <TextBox Grid.Column="2" Text="{Binding StartLevel, StringFormat=F0}"
                                    Margin="4,4" FontSize="12" TextAlignment="Center"
                                    Background="#0D1B2A" Foreground="{StaticResource TextBrush}"
                                    BorderBrush="#2A3A5E" VerticalContentAlignment="Center"/>

                            <!-- Ch1 Cell -->
                            <Border Grid.Column="3" BorderBrush="#2A3A5E" BorderThickness="1" Margin="2">
                                <TextBlock Text="{Binding Ch1.Value}" HorizontalAlignment="Center"
                                           Margin="4,6" FontWeight="Bold" FontSize="14">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#66BB6A"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Ch1.IsTesting}" Value="True">
                                                    <Setter Property="Foreground" Value="#FFC107"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Ch1.Value}" Value="">
                                                    <Setter Property="Foreground" Value="{StaticResource DimTextBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>

                            <!-- Ch2 Cell -->
                            <Border Grid.Column="4" BorderBrush="#2A3A5E" BorderThickness="1" Margin="2">
                                <TextBlock Text="{Binding Ch2.Value}" HorizontalAlignment="Center"
                                           Margin="4,6" FontWeight="Bold" FontSize="14">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#66BB6A"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Ch2.IsTesting}" Value="True">
                                                    <Setter Property="Foreground" Value="#FFC107"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Ch2.Value}" Value="">
                                                    <Setter Property="Foreground" Value="{StaticResource DimTextBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>

                            <!-- Ch3 Cell -->
                            <Border Grid.Column="5" BorderBrush="#2A3A5E" BorderThickness="1" Margin="2">
                                <TextBlock Text="{Binding Ch3.Value}" HorizontalAlignment="Center"
                                           Margin="4,6" FontWeight="Bold" FontSize="14">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#66BB6A"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Ch3.IsTesting}" Value="True">
                                                    <Setter Property="Foreground" Value="#FFC107"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Ch3.Value}" Value="">
                                                    <Setter Property="Foreground" Value="{StaticResource DimTextBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </GroupBox>

        <!-- ==================== Row 3: Log ==================== -->
        <GroupBox Grid.Row="3">
            <GroupBox.Header>
                <TextBlock Text="&#x1F4DD; Log" FontWeight="Bold"
                           Foreground="{StaticResource HeaderPurple}" FontSize="14"/>
            </GroupBox.Header>
            <ListBox x:Name="LogListBox"
                     ItemsSource="{Binding LogMessages}"
                     Style="{StaticResource LogListBoxStyle}"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#C9D1D9"/>
                        <Setter Property="Padding" Value="4,1"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </GroupBox>
    </Grid>
</Window>
