<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>BTSensitivitySearchV1._0</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>BTSensitivitySearch.ico</ApplicationIcon>
    <!-- Keep only English satellite resources; drop other-language assemblies to shrink the single-file output -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="BTSensitivitySearch.ico" />
  </ItemGroup>

  <Target Name="GenerateBuildTime" BeforeTargets="BeforeCompile;CoreCompile">
    <PropertyGroup>
      <_BuildTimeUtc>$([System.DateTime]::UtcNow.ToString("yyyy-MM-ddTHH:mm:ssZ"))</_BuildTimeUtc>
      <_BuildTimeFile>$(IntermediateOutputPath)BuildTime.g.cs</_BuildTimeFile>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <ItemGroup>
      <_BuildTimeLines Include="// &lt;auto-generated /&gt;" />
      <_BuildTimeLines Include="namespace BTSensitivitySearchV1._0%3B" />
      <_BuildTimeLines Include="internal static class BuildInfo" />
      <_BuildTimeLines Include="{" />
      <_BuildTimeLines Include="    public const string BuildTimeUtc = &quot;$(_BuildTimeUtc)&quot;%3B" />
      <_BuildTimeLines Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(_BuildTimeFile)" Lines="@(_BuildTimeLines)" Overwrite="true" />
    <ItemGroup>
      <Compile Remove="$(_BuildTimeFile)" />
      <Compile Include="$(_BuildTimeFile)" />
      <FileWrites Include="$(_BuildTimeFile)" />
    </ItemGroup>
  </Target>

</Project>
